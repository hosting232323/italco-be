# Pianificazione automatica AI (sperimentale) - /schedule/suggestions?strategy=ai
# AI_SCHEDULATION_ENABLED=''  # '1'/'true' per abilitare il ramo AI, altrimenti risponde ko
# CLAUDE_CLI_PATH=''  # percorso della CLI `claude`, default: risolta dal PATH
# CLAUDE_CLI_MODEL=''  # modello da passare alla CLI, vuoto = default della CLI
# CLAUDE_CLI_TIMEOUT=''  # secondi di attesa per la CLI, default 180

# Sessione
# ACCESS_TOKEN_MINUTES=''
# REFRESH_TOKEN_DAYS=''
# REFRESH_COOKIE_PATH=''  # in produzione /api
# REFRESH_COOKIE_SAMESITE=''  # in produzione Strict
# REFRESH_GRACE_SECONDS=''  # refresh concorrenti (piu' schede aperte), default 30
# EXTRA_ALLOWED_ORIGINS=''  # origin extra per la CORS, separate da virgola

# Production
# API_PREFIX
# STATIC_FOLDER=''
# EURONICS_API_PASSWORD=''
# DELIVERY_APP_MIN_BUILD_NUMBER=''  # blocca l'app corrieri sotto questo build number, vuoto = nessuna soglia

